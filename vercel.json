{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/api/admin/[[...slug]]" },
    { "source": "/admin", "destination": "/api/admin/[[...slug]]" }
  ]
}
